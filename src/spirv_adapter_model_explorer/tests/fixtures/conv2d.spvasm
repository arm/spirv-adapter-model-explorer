; SPIR-V
; Version: 1.0
; Bound: 200
; Schema: 0
OpCapability Shader
OpCapability TensorsARM
OpCapability GraphARM
OpCapability Int8
OpExtension "SPV_ARM_tensors"
OpExtension "SPV_ARM_graph"
%tosa = OpExtInstImport "TOSA.001000.1"
OpMemoryModel Logical GLSL450

%uint = OpTypeInt 32 0
%uint8 = OpTypeInt 8 0
%uint_0 = OpConstant %uint 0
%uint_1 = OpConstant %uint 1
%uint_2 = OpConstant %uint 2
%uint_3 = OpConstant %uint 3
%uint_4 = OpConstant %uint 4
%uint_5 = OpConstant %uint 5
%uint_6 = OpConstant %uint 6
%uint_7 = OpConstant %uint 7
%uint_8 = OpConstant %uint 8
%uint_9 = OpConstant %uint 9
%uint_array_l1 = OpTypeArray %uint %uint_1
%shape = OpConstantComposite %uint_array_l1 %uint_1
%tensor = OpTypeTensorARM %uint8 %uint_1 %shape
%ptr_tensor = OpTypePointer UniformConstant %tensor
%graph_type = OpTypeGraphARM 10 %tensor %tensor %tensor %tensor %tensor %tensor %tensor %tensor %tensor %tensor %tensor

%pad_ptr = OpVariable %ptr_tensor UniformConstant
%stride_ptr = OpVariable %ptr_tensor UniformConstant
%dilation_ptr = OpVariable %ptr_tensor UniformConstant
%acc_type_ptr = OpVariable %ptr_tensor UniformConstant
%local_bound_ptr = OpVariable %ptr_tensor UniformConstant
%input_ptr = OpVariable %ptr_tensor UniformConstant
%weight_ptr = OpVariable %ptr_tensor UniformConstant
%bias_ptr = OpVariable %ptr_tensor UniformConstant
%input_zp_ptr = OpVariable %ptr_tensor UniformConstant
%weight_zp_ptr = OpVariable %ptr_tensor UniformConstant
%output_ptr = OpVariable %ptr_tensor UniformConstant

OpGraphEntryPointARM %graph "main" %pad_ptr %stride_ptr %dilation_ptr %acc_type_ptr %local_bound_ptr %input_ptr %weight_ptr %bias_ptr %input_zp_ptr %weight_zp_ptr %output_ptr
%graph = OpGraphARM %graph_type
%pad = OpGraphInputARM %tensor %uint_0
%stride = OpGraphInputARM %tensor %uint_1
%dilation = OpGraphInputARM %tensor %uint_2
%acc_type = OpGraphInputARM %tensor %uint_3
%local_bound = OpGraphInputARM %tensor %uint_4
%input = OpGraphInputARM %tensor %uint_5
%weight = OpGraphInputARM %tensor %uint_6
%bias = OpGraphInputARM %tensor %uint_7
%input_zp = OpGraphInputARM %tensor %uint_8
%weight_zp = OpGraphInputARM %tensor %uint_9
%conv = OpExtInst %tensor %tosa CONV2D %pad %stride %dilation %acc_type %local_bound %input %weight %bias %input_zp %weight_zp
OpGraphSetOutputARM %conv %uint_0
OpGraphEndARM
